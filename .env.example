# Application
NEXT_PUBLIC_SITE_URL=https://amarapjy.xyz
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled Jobs and Automation (GitHub Actions / Vercel Cron)
CRON_SECRET=
NIGHTLY_JOB_TOKEN=
LETTER_GENERATION_TOKEN=
LETTER_AUTO_GENERATE=false

# Comma-separated administrator allowlists for the independent /admin session (server-only).
# Admin login uses these Supabase credentials but never reads or changes chat auth cookies.
ADMIN_EMAILS=
ADMIN_USER_IDS=

# AI and existing memory retrieval
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Waffo Pancake. Use WAFFO_PRIVATE_KEY_BASE64 when your host cannot store multiline PEM values.
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_ENVIRONMENT=test
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=
WAFFO_PRODUCT_PLUS_TRIAL=PROD_replace_me
WAFFO_PRODUCT_PLUS_MONTHLY=PROD_replace_me
WAFFO_PRODUCT_PLUS_YEARLY=PROD_replace_me
# Reserved for a future launch; Premium checkout is currently rejected by the server.
WAFFO_PRODUCT_PREMIUM_MONTHLY=PROD_replace_me
WAFFO_PRODUCT_PREMIUM_YEARLY=PROD_replace_me

# Webhook URL in the Waffo dashboard:
# https://amarapjy.xyz/api/pay/waffo/webhook

# QQ official bot (server-only). Webhook:
# https://amarapjy.xyz/api/qq/webhook
# Subscribe to C2C_MESSAGE_CREATE and GROUP_AT_MESSAGE_CREATE.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
# Supabase auth user UUID whose active companion and memories QQ should use.
QQ_AMARA_USER_ID=
# Optional: pin a specific companion UUID owned by QQ_AMARA_USER_ID.
QQ_AMARA_COMPANION_ID=
# Comma-separated QQ OpenIDs, not QQ numbers. Send /whoami to the bot to obtain one.
QQ_ALLOWED_OPENIDS=
